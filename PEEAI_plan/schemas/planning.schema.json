        "reserved_delta_cents",
        "related_plan_id",
        "constraint_report_ref",
        "error_code",
        "actor_id",
        "request_digest"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "applied"
              }
            }
          },
          "then": {
            "properties": {
              "error_code": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "rejected"
              }
            }
          },
          "then": {
            "properties": {
              "state_changes": {
                "maxItems": 0
              },
              "committed_delta_cents": {
                "const": 0
              },
              "reserved_delta_cents": {
                "const": 0
              },
              "error_code": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
