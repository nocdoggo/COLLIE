# Plan B live agent (Wave 2) model endpoint configuration. Names only, with non-secret example
# values: never put a key here. The application does not read this file; set the variables in
# the server's environment, or keep them in .local/keys/model_endpoint.env (repository root),
# which plan_b/agent/config.py reads when a variable is not set in the environment.
# Relative paths resolve against the repository root.

# openrouter or openai_compatible
PLAN_B_MODEL_PROVIDER=openrouter
# https only (plain http only for 127.0.0.1 test servers); no credentials or query in the URL
PLAN_B_MODEL_BASE_URL=https://openrouter.ai/api/v1
# Path of the file holding the key (mode 0600, ignored by Git). The key itself never goes here.
PLAN_B_MODEL_KEY_FILE=.local/keys/openrouter.key
# Default: anthropic/claude-sonnet-5.5
PLAN_B_MODEL_ID=anthropic/claude-sonnet-5.5
# Spend caps in US dollars: per run (one policy episode or one gate run) and cumulative over the
# ledger apps/plan_b/var/model_spend.json. Defaults: 0.50 and 20.00.
PLAN_B_MODEL_MAX_RUN_COST_USD=0.50
PLAN_B_MODEL_MAX_TOTAL_COST_USD=20.00
