  "fixture_extensions": [
    {
      "extension_id": "x01_resource_terms",
      "field_path": "resources[].terms",
      "reason": "Planning Resource has only booking_cost_cents, which maps to terms.commitment_cost_cents unchanged. The backup learning kit's 4000-cent cost is made a booking: an authorized free hold reserves 4000 cents (the coordinator grant's max_total_reserved_cents) for ten simulated minutes, and a booking must be committed 15 minutes before use. The expected learning kit and the backup kit name their registered status sources."
    },
    {
      "extension_id": "x02_principals",
      "field_path": "principals",
      "reason": "Explicit principal registry binding each demo identity to one role and grant. The planning grants name agent_demo, participant_peer_lead and participant_kit_steward; the kit steward speaks for the backup kit it offers. Sessions are issued per principal; request bodies cannot set identity."
    },
    {
      "extension_id": "x03_host_mentor_grants",
      "field_path": "authority_grants[grant_host_self, grant_mentor_self]",
      "reason": "The planning fixture has a self-scoped check-in grant only for the peer lead, but readiness requires every assigned person to check in. The host and mentor get the same self-scoped grant to record their own availability. Neither can change the plan, the goal, or another participant."
    },
    {
      "extension_id": "x04_organizer_grant",
      "field_path": "authority_grants[grant_organizer_demo]",
      "reason": "Planning review_required_for names organizer decisions but the fixture has no organizer principal. The organizer grant allows goal-preference and grant changes through authenticated controls, bounded by the 8000-cent event budget. It does not apply plans."
    },
    {
      "extension_id": "x05_goal_preferences",
      "field_path": "goal.preference_preset, goal.objective_weights",
      "reason": "Planning priorities are prose. The 'balanced' preset's integer weights make ranking reproducible: 4000 cents of spend (160 points) costs more than moving peer exchange ahead of the demonstration and practice (150 points)."
    },
    {
