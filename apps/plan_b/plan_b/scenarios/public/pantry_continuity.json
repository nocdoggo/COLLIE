  "declared_assumptions": [
    {
      "assumption_id": "a_fiction",
      "description": "All stock, people, targets, timings and events are synthetic. This is not U-ACCESS operating data.",
      "basis": "scenario_design",
      "source_ref": "fictional_fixture_spec"
    },
    {
      "assumption_id": "a_unit",
      "description": "Every unit is a preassembled, identical shelf-stable kit. No recipes, allergies, perishability or recipient decisions are modeled.",
      "basis": "scenario_design",
      "source_ref": "fictional_fixture_spec"
    },
    {
      "assumption_id": "a_capacity",
      "description": "attendance_target 12 is a fixture occupancy planning bound, not a people-served count. Forty kits do not imply forty recipients. Stock Resource.capacity 100 is the storage bound, not available supply.",
      "basis": "scenario_design",
      "source_ref": "fictional_fixture_spec"
    },
    {
      "assumption_id": "a_initial_plan",
      "description": "The initial schedule has a feasible 24-unit partial allocation proposal and no inventory reservation. Its 40-unit target is unresolved. It is not a full-success or execution-ready plan until quantities are reserved and staff readiness checks pass.",
      "basis": "scenario_design",
      "source_ref": "fictional_fixture_spec"
    },
    {
      "assumption_id": "a_throughput",
      "description": "The registered staff team can distribute up to 40 kits during the 40-minute distribution window. This is an authored capacity assumption, not observed pantry throughput.",
      "basis": "scenario_design",
      "source_ref": "fictional_fixture_spec"
    },
    {
      "assumption_id": "a_handoff",
      "description": "Partner stock is at the same venue. A source hold does not transfer it. Staff-confirmed receipt atomically debits source and credits destination, then destination stock is separately reserved and committed.",
      "basis": "scenario_design",
      "source_ref": "fictional_fixture_spec"
    },
    {
      "assumption_id": "a_expected",
      "description": "Expected S20 supply is excluded from usable stock until a unique staff receipt matches the shipment. Internal partner handoff does not decrement S20.",
      "basis": "scenario_design",
      "source_ref": "fictional_fixture_spec"
    },
    {
      "assumption_id": "a_counters",
      "description": "Initial pantry supply shortfall is 16. Initial service deficit is 40 because distributed quantity is zero. Partner stock is potential cover until authorized handoff, not already pantry-controlled supply.",
      "basis": "scenario_design",
      "source_ref": "fictional_fixture_spec"
    },
    {
      "assumption_id": "a_authority",
      "description": "The agent can reserve and plan but cannot attest receipt or distribution. Human demo staff use separate scoped credentials. All physical actions are simulated.",
      "basis": "scenario_design",
      "source_ref": "fictional_fixture_spec"
    },
    {
      "assumption_id": "a_budget",
      "description": "Both holdings and internal transfers have zero configured cost. No purchases or external bookings are permitted.",
      "basis": "scenario_design",
      "source_ref": "fictional_fixture_spec"
    },
    {
      "assumption_id": "a_service_clock",
      "description": "The runner records actual staffed execution start only after the plan is committed and stock reserved. Capacity at time t is floor(1 kit per minute times elapsed qualified staffed execution minutes), minus previously distributed units. A late commitment cannot backdate this clock. A completion at 13:40 counts before the service deadline-close event at that same time. Later physical distribution may be recorded within staff authority, but misses the original target deadline.",
      "basis": "scenario_design",
      "source_ref": "fictional_fixture_spec"
    },
    {
      "assumption_id": "a_staff_response",
      "description": "A valid source hold with purpose stock_transfer and destination_resource_id pantry_stock creates a local staff handoff task. A two-minute modeled response begins after that task is valid. Staff may attest at completion only while the hold and handoff window remain valid. 12:50 is exclusive for hold/transfer acceptance. Staff response conditions are fixed across policies; the model cannot assume acceptance.",
      "basis": "scenario_design",
      "source_ref": "fictional_fixture_spec"
    },
    {
      "assumption_id": "a_handoff_workload",
      "description": "handoff_duration_minutes is modeled response latency. In this bounded fixture staff may confirm the same-venue stock handoff as part of setup, so it is not an additional exclusive staffing activity. The handoff window ends before briefing starts. A domain requiring separate lifting, transport or active staff time needs an explicit scheduled activity and capacity check before use.",
      "basis": "scenario_design",
      "source_ref": "fictional_fixture_spec"
    }
  ],
  "fixture_extensions": [
    {
      "extension_id": "x01_resource_terms",
      "field_path": "resources[].terms",
      "reason": "Planning Resource has only booking_cost_cents (0 for every resource here). The terms make holding explicit: no resource needs a booking; a pantry_stock hold lives at most 30 minutes, a partner_stock hold at most 20 minutes and never past the exclusive 12:50 handoff cutoff (the steward's 'free hold until 12:50'); releases are refundable at no cost. pantry_stock and partner_stock name their registered status sources. booking_cost_cents maps to terms.commitment_cost_cents unchanged."
    },
    {
      "extension_id": "x02_staff_checkin",
      "field_path": "initial_state.checked_in",
      "reason": "Planning checked_in_roles=['staff'] (and obs_staff: 'Fictional staff team checked in') becomes a check-in record for the staff resource at the 12:30 load, available for its whole 12:30-14:00 window, labeled fixture_initial_state (authored setup, not a runtime check-in)."
    },
    {
      "extension_id": "x03_staff_role",
      "field_path": "authority_grants[grant_pantry_staff].principal_role",
      "reason": "The one departure from a planning value. The planning grant gives the staff principal the organizer role. The runtime has no staff role: staff authority is the grant's allowed_tools (record_stock_receipt, record_distribution), so the staff principal is a participant. An organizer session would also read every receipt and release other principals' holds, which the staff boundary does not need. Every other field of the grant is unchanged."
    },
    {
      "extension_id": "x04_principals",
      "field_path": "principals",
      "reason": "Explicit principal registry binding the coordinator, the staff and the partner steward to one role and grant each. The staff principal speaks for the staff resource; the steward for partner_stock. Sessions are issued per principal; request bodies cannot set identity. No organizer principal exists in this fixture, so no goal version can change."
    },
    {
