{
  "name": "plan-b-web",
  "private": true,
  "version": "0.1.0",
  "description": "Browser board and recorded replay for the Plan B fictional campus sandbox.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc --noEmit -p .",
    "lint": "node scripts/check-boundaries.mjs",
    "test": "node --import ./tests/support/register.mjs --test \"tests/*.test.ts\"",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "5.2.0",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  }
}
